(defpoll uptime :interval "5s" `awk '{t=$1; d=int(t/86400); t%=86400; h=int(t/3600); t%=3600; m=int(t/60); printf("%dd %02d:%02d", d, h, m)}' /proc/uptime
`)

(defpoll time :interval "1s" `date +%H:%M`)

(defpoll volume :interval "2s" "wpctl get-volume @DEFAULT_AUDIO_SINK@ | awk '{print int($2*100)}'")
